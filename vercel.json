{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "prisma generate && pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --config.dangerouslyAllowAllBuilds=true",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 10,
      "includeFiles": [
        "prisma/generated/client/**",
        "node_modules/.prisma/**",
        "node_modules/.pnpm/@prisma+client*/node_modules/.prisma/**"
      ]
    }
  },
  "headers": [
    {
      "source": "/widget.js",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Cache-Control", "value": "public, max-age=300" }]
    },
    {
      "source": "/nscha-solver.js",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/cap/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/_nscha?__nscha_path=/$1" }
  ]
}
