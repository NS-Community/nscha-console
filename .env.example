# ── 数据库 ────────────────────────────────────────────────────────────────
# 本地：SQLite 文件，零配置即可跑
DATABASE_URL="file:./dev.db"
# 生产（Vercel）：换成 Neon Postgres 连接池地址
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/nscha?sslmode=require"

# ── 控制台账号与密钥 ──────────────────────────────────────────────────────
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CONSOLE_JWT_SECRET="replace-with-a-long-random-hex-string"
CONSOLE_ENC_KEY="replace-with-another-long-random-hex-string"

# ── PoW 签名密钥（中央服务签发挑战 / 令牌）───────────────────────────────
CAP_SECRET="replace-with-a-third-long-random-hex-string"
CAP_TOKEN_SECRET="replace-with-another-long-random-hex-string"

# ── 对外地址 ──────────────────────────────────────────────────────────────
# 嵌入代码里展示给站长的端点；不填则从请求 origin 推导
NSCHA_PUBLIC_ORIGIN="https://guard.nsbbs.eu.cc"
# 控制台自身 origin，用于实时预览通道（逗号分隔可填多个）
CONSOLE_ORIGIN="http://localhost:5173,https://guard.nsbbs.eu.cc"
NSCHA_DOCS_URL="https://nscha.nsbbs.eu.cc"

# ── 可选难度 ──────────────────────────────────────────────────────────────
CAP_CHALLENGE_COUNT=20
CAP_CHALLENGE_SIZE=32
CAP_CHALLENGE_DIFFICULTY=3
CAP_EXPIRES_SECONDS=600
CAP_TOKEN_TTL_SECONDS=300

PORT=8789
