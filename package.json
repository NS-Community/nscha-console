{
  "name": "nscha-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NSCHA Console — 中央多租户人机验证服务与站长控制台",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "start": "tsx server/index.ts",
    "build": "node scripts/sync-solver.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "db:local:generate": "prisma generate --schema prisma/local/schema.sqlite.prisma",
    "db:local:push": "prisma db push --schema prisma/local/schema.sqlite.prisma",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "capjs-core": "^0.1.6",
    "dotenv": "^17.2.0",
    "hono": "^4.9.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cap.js/wasm": "^0.0.8",
    "@cap.js/widget": "^0.1.58",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "pako": "^2.1.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
